{
  "name": "optcg-recorder",
  "version": "0.12.0",
  "private": true,
  "description": "Records OPTCG Sim games, tags them from the combat log, and plays them back.",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "ingest-leaders": "node scripts/ingest-leaders.mjs",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "author": "Khoi Le",
  "build": {
    "appId": "io.github.optcgrecorder",
    "productName": "OPTCG Recorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Records OPTCG Sim games and plays them back"
    },
    "appImage": {
      "artifactName": "OPTCG-Recorder-${version}-x86_64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OPTCG-Recorder-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OPTCG-Recorder-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "khoile3009",
      "repo": "optcg-recorder"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
